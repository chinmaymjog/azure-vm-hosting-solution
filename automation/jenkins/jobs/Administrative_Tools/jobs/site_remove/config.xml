  <builders>
    <hudson.tasks.Shell>
      <command>if [ &quot;${site_type}&quot; = &quot;html&quot; ]; then
	echo &quot;Deleting HTML site ${site_url} on ${web_environment}&quot;
    ansible-playbook -u &quot;$ANSIBLE_USER&quot; --private-key &quot;$ANSIBLE_PVT_KEY&quot; --extra-vars &quot;site_url=${site_url} web_environment=${web_environment}&quot; /etc/ansible/playbooks/html_site_remove.yml
fi

if [ &quot;${site_type}&quot; = &quot;php&quot; ]; then
	echo &quot;Deleting PHP ${php_version} site ${site_url} on ${web_environment}&quot;
    ansible-playbook -u &quot;$ANSIBLE_USER&quot; --private-key &quot;$ANSIBLE_PVT_KEY&quot; --extra-vars &quot;site_url=${site_url} php_version=${php_version} web_environment=${web_environment}&quot; /etc/ansible/playbooks/php_site_remove.yml
fi</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
