  <builders>
    <hudson.tasks.Shell>
      <command>if [ &quot;${site_type}&quot; = &quot;html&quot; ]; then
	echo &quot;Adding HTML site ${site_url} concurrently on all environments&quot;
    ansible-playbook -u &quot;$ANSIBLE_USER&quot; --private-key &quot;$ANSIBLE_PVT_KEY&quot; --extra-vars &quot;site_url=${site_url}&quot; /etc/ansible/playbooks/html_site_add.yml
fi

if [ &quot;${site_type}&quot; = &quot;php&quot; ]; then
	echo &quot;Adding PHP ${php_version} site ${site_url} concurrently on all environments&quot;
    ansible-playbook -u &quot;$ANSIBLE_USER&quot; --private-key &quot;$ANSIBLE_PVT_KEY&quot; --extra-vars &quot;site_url=${site_url} php_version=${php_version}&quot; /etc/ansible/playbooks/php_site_add.yml
fi</command>
